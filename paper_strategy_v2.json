      "confirmation_timeout_ms": 30000,
      "cooldown_ms": 60000
    },
    {
      "name": "terminal_level_breakout",
      "role": "execution",
      "direction": "both",
      "attempts_per_setup": 1,
      "diagnostic": false,
      "confirmation_timeout_ms": 2000,
      "cooldown_ms": 60000
    },
    {
      "name": "target_seeking_breakout",
      "role": "execution",
      "direction": "both",
      "attempts_per_setup": 1,
      "diagnostic": false,
